# Texto normalizado a LF en todo el repo (evita diffs fantasma entre worktrees)
* text=auto eol=lf

# Scripts nativos de Windows con CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Ficheros gestionados por Spec Kit: se guardan tal cual (sus manifiestos verifican hashes SHA-256)
.specify/** -text
.claude/skills/speckit-*/** -text

# Binarios
*.wav binary
*.flac binary
*.mp3 binary
*.ogg binary
*.png binary
*.jpg binary
*.ico binary
*.onnx binary
