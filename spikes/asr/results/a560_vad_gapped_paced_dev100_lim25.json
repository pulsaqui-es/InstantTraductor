    "vad_delay_s": 0.567,
    "post_decision_s": 0.189,
    "text_complete_latency_s": 0.445
   },
   {
    "seg": 12,
    "text": "He laments most bitterly the divorce that has been made between decorative art and what we usually call pictures",
    "t_start": 106.88000000000001,
    "t_end": 114.848,
    "decided_at": 115.36,
    "emitted_at": 115.491,
    "true_start": 107.17,
