    "vad_delay_s": 0.577,
    "post_decision_s": 0.118
   },
   {
    "seg": 15,
    "text": "And the ornaments Fred brought home from India on the mantle board",
    "t_start": 127.74400000000001,
    "t_end": 131.552,
    "decided_at": 132.06400000000002,
