  "segments": [
   {
    "seg": 0,
    "text": "Mister Quilter is the apostle of the middle classes and we are glad to welcome his gospel",
    "t_start": 1.28,
    "t_end": 6.496,
    "decided_at": 7.008,
    "emitted_at": 7.281,
    "true_start": 1.54,
    "true_end": 6.415,
    "forced": false,
    "n_partials": 8,
    "first_partial_latency_s": 1.152,
