    "text_complete_latency_s": 0.409
   },
   {
    "seg": 16,
    "text": "In fact, he is quite severe on Mister Ruskin for not recognizing that a picture should denote the frailty of man",
    "t_start": 133.696,
    "t_end": 141.472,
