    "post_decision_s": 0.206,
    "text_complete_latency_s": 0.176
   },
   {
    "seg": 7,
    "text": "And Mister John Collier gives his sitter a cheerful slap on the back before he says like a shampoo or in a Turkish bath, next man",
    "t_start": 60.160000000000004,
    "t_end": 69.75999999999999,
    "decided_at": 70.27199999999999,
    "emitted_at": 70.39,
    "true_start": 60.14,
    "true_end": 69.655,
    "forced": false,
    "n_partials": 15,
    "first_partial_latency_s": 1.453,
    "first_text_latency_s": 1.453,
    "final_latency_s": 0.735,
    "vad_delay_s": 0.617,
    "post_decision_s": 0.118,
    "text_complete_latency_s": 0.237
   },
   {
    "seg": 8,
    "text": "It is obviously unnecessary for us to point out how luminous these criticisms are, how delicate in expression",
    "t_start": 72.03200000000001,
    "t_end": 80.32,
    "decided_at": 80.832,
    "emitted_at": 80.991,
    "true_start": 72.29,
    "true_end": 80.275,
    "forced": false,
    "n_partials": 13,
    "first_partial_latency_s": 0.6,
