    "final_latency_s": 0.655,
    "vad_delay_s": 0.553,
    "post_decision_s": 0.102
   },
   {
    "seg": 11,
    "text": "As for etchings, they are of two kinds British and foreign",
    "t_start": 100.41600000000001,
    "t_end": 104.768,
    "decided_at": 105.312,
    "emitted_at": 105.501,
    "true_start": 100.68,
