    "final_latency_s": 0.685,
    "vad_delay_s": 0.503,
    "post_decision_s": 0.182,
    "text_complete_latency_s": -0.115
   },
   {
    "seg": 10,
    "text": "Painting he tells us is of a different quality to mathematics and Finnish in art is adding more fact",
    "t_start": 89.664,
    "t_end": 98.176,
    "decided_at": 98.688,
    "emitted_at": 98.79,
    "true_start": 89.92,
