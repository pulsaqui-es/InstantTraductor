    "final_latency_s": 0.666,
    "vad_delay_s": 0.535,
    "post_decision_s": 0.131,
    "text_complete_latency_s": 0.165
   },
   {
    "seg": 13,
    "text": "Makes a customary appeal to the last judgment and reminds us that in the great days of art, Michelangelo was the furnishing upholsterer",
    "t_start": 115.232,
    "t_end": 124.48,
    "decided_at": 125.024,
