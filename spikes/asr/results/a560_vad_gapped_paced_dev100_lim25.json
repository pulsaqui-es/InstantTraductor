    "final_latency_s": 0.756,
    "vad_delay_s": 0.575,
    "post_decision_s": 0.181,
    "text_complete_latency_s": 0.066
   },
   {
    "seg": 6,
    "text": "Mister Burke at Foster's landscapes smile at one much in the same way that Mister Carker used to flash his teeth",
    "t_start": 51.93600000000001,
    "t_end": 59.36,
    "decided_at": 59.872,
    "emitted_at": 60.078,
    "true_start": 52.2,
    "true_end": 59.315,
    "forced": false,
    "n_partials": 13,
