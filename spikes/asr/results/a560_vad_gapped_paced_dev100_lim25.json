    "vad_delay_s": 0.557,
    "post_decision_s": 0.159,
    "text_complete_latency_s": 0.418
   },
   {
    "seg": 9,
    "text": "On the general principles of art, Mister Quilter writes with equal lucidity",
    "t_start": 82.72,
    "t_end": 88.064,
    "decided_at": 88.608,
    "emitted_at": 88.79,
    "true_start": 82.99,
