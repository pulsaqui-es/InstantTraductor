    "post_decision_s": 0.273,
    "text_complete_latency_s": 0.178
   },
   {
    "seg": 1,
    "text": "Nor is Mister Quilter's manner less interesting than his matter",
    "t_start": 8.864,
    "t_end": 13.088000000000001,
    "decided_at": 13.6,
    "emitted_at": 13.692,
    "true_start": 9.14,
    "true_end": 12.975,
    "forced": false,
    "n_partials": 7,
