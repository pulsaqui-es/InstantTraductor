    "post_decision_s": 0.106,
    "text_complete_latency_s": 0.252
   },
   {
    "seg": 3,
    "text": "Similes drawn from eating and its results occur most readily to the mind",
    "t_start": 22.528,
    "t_end": 27.168,
    "decided_at": 27.712,
    "emitted_at": 27.89,
    "true_start": 22.8,
