    "text_complete_latency_s": 0.071
   },
   {
    "seg": 6,
    "text": "Mister Burke at Foster's landscapes smile at one much in the same way that Mister Carker used to flash his teeth",
    "t_start": 51.93600000000001,
    "t_end": 59.36,
