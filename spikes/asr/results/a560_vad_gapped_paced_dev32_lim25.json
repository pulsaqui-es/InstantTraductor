    "text_complete_latency_s": 0.119
   },
   {
    "seg": 7,
    "text": "And Mister John Collier gives his sitter a cheerful slap on the back before he says like a shampoo or in a Turkish bath, next man",
    "t_start": 60.160000000000004,
